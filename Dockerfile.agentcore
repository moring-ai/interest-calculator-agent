# Build file for platforms that deploy this repo directly (AICP "Custom"
# framework), which look for `Dockerfile.agentcore` at the repository root and
# build with the root as the context.
#
# It produces the same image as agent/Dockerfile; the difference is only where
# the paths are anchored. agent/Dockerfile assumes a build context of `agent/`
# (that is what the agentcore CLI passes via buildContextPath), so every COPY in
# it is relative to that directory and it fails from the root. Rather than make
# one file serve both and be subtly wrong for each, this one owns the
# root-context case and keeps its paths explicit.
#
#     docker build --platform linux/arm64 -f Dockerfile.agentcore -t interest-agent .
#
# AgentCore Runtime requires linux/arm64 and an HTTP server on 0.0.0.0:8080
# exposing POST /invocations and GET /ping. BedrockAgentCoreApp implements that
# contract, so main.py only supplies the entrypoint generator.
FROM python:3.12-slim AS base

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_SYSTEM_PYTHON=1 \
    UV_COMPILE_BYTECODE=1

WORKDIR /app

# Dependencies first so source edits do not invalidate the install layer.
COPY agent/pyproject.toml ./
RUN uv pip install --no-cache \
        "aws-opentelemetry-distro" \
        "bedrock-agentcore>=1.9.1" \
        "boto3>=1.35.0" "botocore[crt]>=1.35.0" \
        "mcp~=1.24.0" \
        "strands-agents>=1.15.0"

# Only the agent ships. packages/, mcp_server/ and infra/ belong to the tool
# server and its infrastructure; the agent reaches those over the network.
COPY agent/ .

RUN useradd --create-home --uid 10001 agent && chown -R agent:agent /app
USER agent

ENV AGENT_PORT=8080
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/ping',timeout=3).status==200 else 1)" || exit 1

CMD ["python", "main.py"]
